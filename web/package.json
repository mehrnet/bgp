{
  "name": "bgp-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-quality.mjs",
    "check": "npm run typecheck && npm run lint",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "deploy": "npm run check && npm run test && npm run build && npx --yes wrangler@4 deploy --config wrangler.toml"
  },
  "dependencies": {
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-solid": "^2.11.2"
  }
}
